# Copiez ce fichier en .env et remplissez vos valeurs.
PORT=3000

# --- Apple Wallet (certificat Apple Developer requis) ---
# Chemins vers vos fichiers .pem (convertis depuis votre .p12 + WWDR).
APPLE_WWDR_CERT=./certs/wwdr.pem
APPLE_SIGNER_CERT=./certs/signerCert.pem
APPLE_SIGNER_KEY=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_PASS_TYPE_ID=pass.com.votredomaine.facturation
APPLE_TEAM_ID=XXXXXXXXXX

# --- Google Wallet (compte de service Google Wallet API) ---
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_CLASS_ID=3388000000000000000.facturation_class
GOOGLE_SA_EMAIL=wallet@votre-projet.iam.gserviceaccount.com
# Chemin vers le fichier de clé, OU la clé PEM directe avec \n échappés.
GOOGLE_SA_PRIVATE_KEY=./certs/google-sa.json
